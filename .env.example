# Plantilla de variables de entorno.
# Copiar a .env y completar los valores reales. El archivo .env NO se versiona.
#
#   cp .env.example .env
#
# Todas estas variables tienen valor por defecto en la configuracion de Spring,
# salvo DB_PASSWORD y JWT_SECRET. Solo hace falta definirlas aqui para sobreescribirlas.

# ===== Entorno de desarrollo (perfil por defecto) =====
DB_URL=jdbc:postgresql://localhost:5432/procesos_empresariales
DB_USERNAME=procesos_app

# ===== Entorno de pruebas (perfil "test") =====
# La URL de la base de pruebas NO es configurable: esta fija en
# src/test/resources/application-test.properties por seguridad (create-drop).
TEST_DB_USERNAME=procesos_app

# ===== Credencial compartida por ambos entornos =====
# Obligatoria. No escribir la contrasena real en este archivo.
DB_PASSWORD=

# ===== JWT =====
# Obligatoria para arrancar la aplicacion (las pruebas usan una clave aleatoria propia).
# Clave HS256 en Base64 de al menos 32 bytes; por ejemplo, generarla con:
#   openssl rand -base64 48
JWT_SECRET=

# Atributo Secure de la cookie de refresco (por defecto true). Solo para desarrollo
# local por http en navegadores que no acepten cookies Secure en localhost:
# COOKIE_SEGURA=false

# Expresion cron (UTC) de la purga de refresh tokens caducados; por defecto cada hora.
# Con "-" se desactiva.
# PURGA_REFRESCO_CRON=0 17 * * * *

# ===== Datos demo (solo con el perfil "demo") =====
# Sin valor por defecto. Solo se exigen cuando el perfil demo crea el dataset demo
# por primera vez; deben tener entre 8 y 100 caracteres.
# No escribir contrasenas reales en este archivo.
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
