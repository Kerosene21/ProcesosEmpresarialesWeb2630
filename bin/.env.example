# Plantilla de variables de entorno.
# Copiar a .env y completar los valores reales. El archivo .env NO se versiona.
#
#   cp .env.example .env
#
# Todas estas variables tienen valor por defecto en la configuracion de Spring,
# salvo DB_PASSWORD. Solo hace falta definirlas aqui para sobreescribirlas.

# ===== Entorno de desarrollo (perfil por defecto) =====
DB_URL=jdbc:postgresql://localhost:5432/procesos_empresariales
DB_USERNAME=procesos_app

# ===== Entorno de pruebas (perfil "test") =====
# La URL de la base de pruebas NO es configurable: esta fija en
# src/test/resources/application-test.properties por seguridad (create-drop).
TEST_DB_USERNAME=procesos_app

# ===== Credencial compartida por ambos entornos =====
# Obligatoria. No escribir la contrasena real en este archivo.
DB_PASSWORD=
