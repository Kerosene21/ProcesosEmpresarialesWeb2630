# Contexto de la imagen del frontend: lista de permitidos. Quedan fuera node_modules, dist, .angular,
# npm-audit.json, coverage, .env y cualquier archivo local.
*
!package.json
!package-lock.json
!angular.json
!tsconfig.json
!tsconfig.app.json
!tsconfig.spec.json
!public/
!public/**
!src/
!src/**
!nginx/
!nginx/**
**/.env
**/.env.*
